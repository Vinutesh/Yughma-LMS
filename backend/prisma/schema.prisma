// Prisma schema — a close-to-direct translation of
// `frontend/src/types/domain.ts`, which is itself the product of 5 build
// phases of design work. Every model here has a frontend counterpart; keep
// them in sync rather than letting this drift into its own shape.
//
// Tenant isolation: every tenant-scoped model carries `orgId` with an index.
// That column existing is necessary but not sufficient — the actual
// enforcement is the tRPC middleware in `src/trpc/context.ts`, which injects
// the filter automatically so no resolver can omit it. See BACKEND_PLAN.md.

// Rust-free client (`provider = "prisma-client"` + `engineType = "client"`,
// GA since Prisma 6.16) — queries compile to a plan in a WASM query
// compiler and execute in TypeScript over `@prisma/adapter-neon` (wired up
// in `src/db.ts`), so there is no Rust query-engine *binary* to fetch at
// generate time at all. Not a style preference: the classic
// `prisma-client-js` generator (even with a driver adapter supplying the DB
// connection) still fetches that native binary during `prisma generate` —
// confirmed by reproducing the exact same failure with the adapter already
// wired up — and that fetch reliably ENOENT's on Vercel's build image
// (copying from a corrupted/missing entry under
// /vercel/.cache/prisma/master/<hash>/, across multiple deploys, including
// with the build cache explicitly cleared). Only this generator drops the
// binary dependency entirely, which is what actually closes the bug rather
// than routing around one symptom of it.
generator client {
  provider   = "prisma-client"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization, Users, Roles
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  active
  past_due
  canceled
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  /// Exactly one row should ever have this true — the Yughma Tech
  /// organization that owns every course/video/quiz/certificate template.
  /// Client companies (isPlatform = false) never author content; they only
  /// hold Enrollment grants (access) into the platform org's courses,
  /// created by a platform admin, never self-service. See
  /// `trpc/trpc.ts`'s `requirePlatformAdmin` and `routers/platform.ts`.
  isPlatform         Boolean   @default(false)
  /// Archiving a client org (never the platform org itself — enforced in
  /// `platform.ts`, not here) blocks every one of its users from logging in
  /// (see `auth/login.ts`) without touching a single row of their real
  /// history — enrollments, certificates, submissions all stay intact and
  /// reversible, unlike a hard delete. Named to match `UserStatus` below.
  status             OrganizationStatus @default(active)
  industry           String?
  size               String?
  /// Despite the name, an R2 storage key (e.g. "org_.../logo.png"), not a
  /// real URL — the bucket is private, so every read mints a fresh signed
  /// URL server-side (see `organizations.ts`'s `getLogoUrl`) rather than
  /// this field ever being directly usable as an <img src>.
  logoUrl            String?
  accentColor        String?
  sessionTimeoutHours Int?
  requireSso         Boolean   @default(false)
  trialEndsAt        DateTime?
  plan               String?
  planChosenAt       DateTime?
  seatLimit          Int?
  subscriptionStatus SubscriptionStatus?
  cancelAtPeriodEnd  Boolean   @default(false)
  paymentMethodBrand String?
  paymentMethodLast4 String?
  nextInvoiceAt      DateTime?
  createdAt          DateTime  @default(now())

  users               User[]
  departments         Department[]
  teams               Team[]
  roles               Role[]
  courses             Course[]
  assets              Asset[]
  assetFolders        AssetFolder[]
  assignments         Assignment[]
  certificateTemplates CertificateTemplate[]
  certificates        Certificate[]
  paths               LearningPath[]
  learningPlans       LearningPlan[]
  calendarEvents      CalendarEvent[]
  notifications       NotificationItem[]
  auditLogEntries     AuditLogEntry[]
  skills              Skill[]
  invoices            Invoice[]
  seatRequests        SeatRequest[]
  integrations        Integration[]
  webhooks            Webhook[]
  apiKeys             ApiKeyRecord[]
  threads             Thread[]
  contentReports      ContentReport[]
  xapiStatements      XapiStatement[]
  lrsConnection       LrsConnection?
  learnerProfiles     LearnerProfile[]
}

enum UserStatus {
  active
  deactivated
}

enum OrganizationStatus {
  active
  archived
}

model User {
  id           String     @id @default(cuid())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  name         String
  email        String
  passwordHash String
  /// Set true whenever a platform admin creates an account with a generated
  /// temp password (see `routers/platform.ts`'s `createClientUser` and
  /// `prisma/seed.ts`) — forces the frontend to route the person through
  /// `auth.changePassword` before anything else, so a relayed temp password
  /// doesn't stay the permanent one indefinitely.
  mustChangePassword Boolean @default(false)
  status       UserStatus @default(active)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  teamId       String?
  team         Team?      @relation(fields: [teamId], references: [id])
  roles        UserRole[]
  createdAt    DateTime   @default(now())

  enrollments        Enrollment[]
  submissions        Submission[]
  certificates       Certificate[]
  pathEnrollments    PathEnrollment[]
  notifications      NotificationItem[]
  notificationPrefs  NotificationPreference[]
  calendarEvents     CalendarEvent[]      @relation("EventCreator")
  auditLogAsActor    AuditLogEntry[]      @relation("AuditActor")
  threadsCreated     Thread[]             @relation("ThreadAuthor")
  posts              Post[]
  contentReports     ContentReport[]      @relation("Reporter")
  seatRequests       SeatRequest[]
  assetsUploaded     Asset[]              @relation("AssetUploader")
  coursesCreated     Course[]             @relation("CourseCreator")
  authSessions       AuthSession[]
  scormLaunchTokens  ScormLaunchToken[]
  videoProgress      VideoProgress[]
  scormProgress      ScormProgress[]
  learnerProfile     LearnerProfile?
  notes              Note[]

  @@unique([orgId, email])
  @@index([orgId])
}

model Role {
  id           String       @id @default(cuid())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  name         String
  isSystemRole Boolean      @default(false)
  permissions  Permission[]
  users        UserRole[]

  @@index([orgId])
}

model Permission {
  id       String @id @default(cuid())
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId   String
  resource String
  action   String // "view" | "edit" | "manage"

  @@unique([roleId, resource, action])
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([userId, roleId])
}

/// Database-backed sessions, not JWT — revocable, which matters once
/// impersonation and audit logging are real (see BACKEND_PLAN.md). Looked up
/// via `rawDb`, never the tenant-scoped client: there's no orgId to scope to
/// before the token resolves to a user.
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// Tracks failed logins by the *raw email string*, not a user id — mirrors
/// the frontend mock's lockout behavior (3 fails / 30s), and deliberately
/// covers non-existent emails too, so probing for which addresses have
/// accounts doesn't get a different rate limit than a real one.
model LoginAttempt {
  email       String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
}

/// Same shape as `LoginAttempt`, keyed by client IP instead of email — closes
/// the gap a per-email lockout alone leaves open: credential-stuffing across
/// many different email addresses from one source never trips any single
/// email's counter. Higher threshold/window than the per-email lockout since
/// one IP can legitimately represent an office/NAT full of real users.
model LoginIpAttempt {
  ip          String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
}

model Department {
  id       String       @id @default(cuid())
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId    String
  name     String
  archived Boolean      @default(false)
  teams    Team[]
  users    User[]

  @@index([orgId])
}

model Team {
  id           String     @id @default(cuid())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  name         String
  archived     Boolean    @default(false)
  users        User[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Content Library
// ---------------------------------------------------------------------------

enum AssetKind {
  video
  document
  image
  other
  scorm
}

model AssetFolder {
  id     String       @id @default(cuid())
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  name   String
  assets Asset[]

  @@index([orgId])
}

model Asset {
  id               String       @id @default(cuid())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String
  name             String
  kind             AssetKind
  sizeBytes        BigInt
  durationSeconds  Int?
  folder           AssetFolder? @relation(fields: [folderId], references: [id])
  folderId         String?
  tags             String[]
  uploadedBy       User         @relation("AssetUploader", fields: [uploadedByUserId], references: [id])
  uploadedByUserId String
  uploadedAt       DateTime     @default(now())
  /// Object storage key (R2/S3) — never the file itself.
  storageKey       String?
  /// SCORM only — path, relative to the extracted package's own root, to the
  /// manifest-declared launch file (e.g. "story.html" or
  /// "scormcontent/index.html"). Set once processScormPackage finishes
  /// extracting the uploaded zip; null until then. The raw zip itself lives
  /// at `storageKey` as uploaded; extracted files live under their own
  /// `{orgId}/scorm/{assetId}/...` prefix in the same bucket.
  scormLaunchPath  String?
  lessons          Lesson[]
  scormLaunchTokens ScormLaunchToken[]
  assignments      Assignment[]
  certificateTemplates CertificateTemplate[]

  @@index([orgId])
}

/// A short-lived, narrowly-scoped credential the *SCORM package's own script*
/// presents when it calls back into the app (to fetch the launch page, its
/// sub-resources, and to report progress) — deliberately not the learner's
/// real session token. The sandboxed iframe (`sandbox="allow-scripts"`, no
/// `allow-same-origin`, see ScormPlayer.tsx) runs untrusted third-party JS;
/// handing it a real session token would let a malicious package call any
/// authenticated endpoint as the learner. This token can only ever do one
/// thing: read/report progress for the one (user, lesson) pair it was
/// issued for, and only until it expires.
model ScormLaunchToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Exactly one of lesson/assignment is set — a launch token is issued
  /// for either a SCORM lesson or a SCORM-attached assignment, never
  /// both. Both optional at the DB level; enforced in `scorm.ts`'s
  /// `getLaunchUrl`.
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String?
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([lessonId])
  @@index([assignmentId])
}

/// The actual SCORM "bookmark" — `cmi.suspend_data`, the package's own
/// internal save state (which slide/question it was on), persisted across
/// launches so reopening a package resumes it instead of restarting from
/// the beginning. Distinct from `ScormLaunchToken` (a short-lived, one-
/// session credential) and from `Submission`/`Enrollment.completedLessonIds`
/// (the outcome once finished) — this is what a package reads back via
/// `LMSGetValue("cmi.suspend_data")` on its *next* launch, updated on every
/// progress report during a session, not just at the end. One row per
/// (user, lesson) or (user, assignment) — exactly one of those is ever set,
/// mirroring `ScormLaunchToken`'s own shape.
model ScormProgress {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String?
  suspendData  String      @default("")
  updatedAt    DateTime    @updatedAt

  // Deliberately no `@@unique` here: with `lessonId`/`assignmentId` each
  // nullable and always exactly one of them set, SQL's "NULL is never equal
  // to NULL" rule means a unique index on either column pair would silently
  // fail to catch a real duplicate the moment that column is null for both
  // rows — a well-known footgun, not an oversight. `scorm.ts`'s find-then-
  // create-or-update instead enforces "one row per (user, lesson-or-
  // assignment)" in application code, the same way `ScormLaunchToken`
  // handles this identical lessonId/assignmentId shape.
  @@index([userId, lessonId])
  @@index([userId, assignmentId])
}

// ---------------------------------------------------------------------------
// Courses, Lessons, Enrollments
// ---------------------------------------------------------------------------

enum CourseStatus {
  draft
  published
  archived
}

model Course {
  id                   String           @id @default(cuid())
  org                  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                String
  title                String
  description          String           @default("")
  status               CourseStatus     @default(draft)
  prerequisites        CoursePrerequisite[] @relation("Course")
  requiredFor          CoursePrerequisite[] @relation("Prerequisite")
  skills               CourseSkill[]
  certificateTemplate  CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  certificateTemplateId String?
  createdBy            User             @relation("CourseCreator", fields: [createdByUserId], references: [id])
  createdByUserId      String
  createdAt            DateTime         @default(now())
  publishedAt          DateTime?

  modules      CourseModule[]
  lessons      Lesson[]
  enrollments  Enrollment[]
  assignments  Assignment[]
  pathCourses  PathCourse[]
  calendarEvents CalendarEvent[]
  threads      Thread[]

  @@index([orgId])
}

model CoursePrerequisite {
  course         Course @relation("Course", fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String
  prerequisite   Course @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  prerequisiteId String

  @@id([courseId, prerequisiteId])
}

model CourseModule {
  id       String   @id @default(cuid())
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  title    String
  order    Int
  lessons  Lesson[]

  @@index([courseId])
}

enum LessonContentType {
  text
  video
  file
  link
  scorm
}

enum ScormPackageStatus {
  processing
  ready
}

model Lesson {
  id               String            @id @default(cuid())
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  module           CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId         String
  title            String
  order            Int
  contentType      LessonContentType
  body             String?
  asset            Asset?            @relation(fields: [assetId], references: [id])
  assetId          String?
  url              String?
  estimatedMinutes Int?
  scormStatus      ScormPackageStatus?
  scormLaunchTokens ScormLaunchToken[]
  videoProgress    VideoProgress[]
  scormProgress    ScormProgress[]
  notes            Note[]

  @@index([courseId])
  @@index([moduleId])
}

/// Server-side record of how far a learner has actually gotten into a
/// video lesson — the real anti-cheat mechanism, not just a client-side
/// scrubber restriction (which a technical user could bypass in devtools).
/// `courses.setLessonComplete` refuses to mark a video lesson complete
/// unless this row shows `furthestSeconds` reached (near) `durationSeconds`,
/// so completion can't be forced without actually watching it. One row per
/// (user, lesson); `furthestSeconds` only ever grows, so the frontend's
/// seek-blocking (can't scrub past this point) survives a reload too.
model VideoProgress {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId        String
  furthestSeconds Float    @default(0)
  durationSeconds Float?
  updatedAt       DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

/// A learner's own private scratchpad for one lesson — one row per (user,
/// lesson), not a list of discrete timestamped entries. Nothing else reads
/// this; it exists purely for the learner's own reference.
model Note {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  body      String
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

/// Captured once, at onboarding — what a new org's first admin said they're
/// hoping to achieve, plus the coarse 4-option persona pick already shown in
/// the wizard. `leadScore` is a simple, explainable rule-based v1 (see
/// `learnerProfile.ts`'s `computeLeadScore`), recomputed on every save; not a
/// trained model, deliberately, until there's enough real data to train one
/// on. One row per user — an org's overall "lead" signal is just its admin's
/// row, since only the org's first/admin user goes through onboarding today.
model LearnerProfile {
  id        String   @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  persona   String?
  goal      String?
  leadScore Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum EnrollmentStatus {
  requested
  active
  completed
}

model Enrollment {
  id                  String           @id @default(cuid())
  course              Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId            String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  status              EnrollmentStatus @default(active)
  enrolledAt          DateTime         @default(now())
  completedLessonIds  String[]
  completedAt         DateTime?

  @@unique([courseId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Assignments
// ---------------------------------------------------------------------------

enum SubmissionType {
  text
  file
  both
}

model Assignment {
  id               String         @id @default(cuid())
  org              Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  title            String
  instructions     String
  /// The test/assignment document itself — what the admin uploads for
  /// learners to work from, distinct from `Submission.assetId` (what the
  /// learner hands back). Optional: an assignment can be text-instructions
  /// only, same as before this field existed.
  asset            Asset?         @relation(fields: [assetId], references: [id])
  assetId          String?
  dueAt            DateTime?
  submissionType   SubmissionType
  pointsPossible   Int
  /// At most one qualifying assignment per course (enforced in
  /// `routers/assignments.ts`'s create/update, not here) — the one
  /// submission whose graded score gates that course's certificate. A
  /// course with no qualifying assignment issues its certificate on lesson
  /// completion alone, unchanged from before this field existed.
  isQualifying     Boolean        @default(false)
  /// Percent of `pointsPossible` a graded submission must reach for this
  /// assignment to count as passed, when it's the qualifying one.
  passingScorePercent Int         @default(85)
  createdByUserId  String
  createdAt        DateTime       @default(now())

  submissions Submission[]
  scormLaunchTokens ScormLaunchToken[]
  scormProgress ScormProgress[]

  @@index([orgId])
  @@index([courseId])
}

model Submission {
  id             String     @id @default(cuid())
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId   String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  submittedAt    DateTime   @default(now())
  text           String?
  assetId        String?
  /// Informational only now — no longer what decides pass/fail. A SCORM
  /// assessment reports its own outcome via `passed` below (its own
  /// `cmi.core.lesson_status` of "passed"/"failed"), since a package can be
  /// internally configured to require its own score threshold and simply
  /// never report success at all below it — comparing a raw score against
  /// `Assignment.passingScorePercent` here would have been redundant with,
  /// and could disagree with, that decision the package already made.
  score          Int?
  /// The actual certificate-gating signal for a SCORM assessment: true once
  /// the package reports "passed" (or a neutral "completed" — same shape as
  /// `lessonStatus` values `courses.ts`/`scorm/shim.ts` already use), false
  /// on an explicit "failed", null while still in progress/never attempted.
  passed         Boolean?
  feedback       String?
  gradedByUserId String?
  gradedAt       DateTime?
  flagged        Boolean    @default(false)

  @@index([assignmentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Certificates
// ---------------------------------------------------------------------------

model CertificateTemplate {
  id        String       @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  name      String
  /// An admin-uploaded design (e.g. from Canva) to render behind the
  /// dynamic fields instead of the app's one fixed layout. Optional —
  /// a template with no background still renders the original fixed
  /// design (see `CertificateFace.tsx`).
  backgroundAsset   Asset?  @relation(fields: [backgroundAssetId], references: [id])
  backgroundAssetId String?
  /// Where the recipient name / course title / issue date land on
  /// `backgroundAsset`, as {x,y} percentages (0-100) of the image's own
  /// width/height — set via the drag-to-position tool in Manage >
  /// Certificates. Shape: `{ name: {x,y}, course: {x,y}, date: {x,y} }`.
  /// Meaningless without a `backgroundAssetId`.
  overlayLayout Json?
  createdAt DateTime     @default(now())

  courses      Course[]
  paths        LearningPath[]
  certificates Certificate[]

  @@index([orgId])
}

enum CertificateSourceKind {
  course
  path
  manual
}

model Certificate {
  id                String                @id @default(cuid())
  org               Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId             String
  template          CertificateTemplate   @relation(fields: [templateId], references: [id])
  templateId        String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  sourceKind        CertificateSourceKind
  sourceId          String?
  sourceTitle       String
  issuedAt          DateTime              @default(now())
  verificationCode  String                @unique
  revoked           Boolean               @default(false)
  revokedAt         DateTime?
  revokedByUserId   String?

  @@index([orgId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Learning Paths, Career Paths, Academies, Skills
// ---------------------------------------------------------------------------

enum PathStatus {
  draft
  published
}

model LearningPath {
  id                    String     @id @default(cuid())
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                 String
  title                 String
  description           String     @default("")
  status                PathStatus @default(draft)
  courses               PathCourse[]
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  certificateTemplateId String?
  createdByUserId       String
  createdAt             DateTime   @default(now())
  publishedAt           DateTime?

  enrollments PathEnrollment[]

  @@index([orgId])
}

model PathCourse {
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  pathId   String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  order    Int

  @@id([pathId, courseId])
}

model PathEnrollment {
  id          String       @id @default(cuid())
  path        LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  pathId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  enrolledAt  DateTime     @default(now())
  completedAt DateTime?

  @@unique([pathId, userId])
}

model Skill {
  id       String       @id @default(cuid())
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId    String
  name     String
  archived Boolean      @default(false)
  courses  CourseSkill[]

  @@index([orgId])
}

model CourseSkill {
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId  String

  @@id([courseId, skillId])
}

/// A named, published group of LearningPaths — "take these paths, in this
/// bundle, to complete the plan." Membership is a flat pathId list
/// (validated against real LearningPath rows on write, not FK-enforced),
/// not a join table; this was Academy before it was narrowed to paths-only
/// and renamed to match what it's actually for.
model LearningPlan {
  id              String       @id @default(cuid())
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId           String
  title           String
  description     String       @default("")
  status          PathStatus   @default(draft)
  heroImageAssetId String?
  pathIds         String[]
  createdByUserId String
  createdAt       DateTime     @default(now())
  publishedAt     DateTime?

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

model CalendarEvent {
  id              String       @id @default(cuid())
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId           String
  course          Course?      @relation(fields: [courseId], references: [id])
  courseId        String?
  title           String
  description     String?
  startsAt        DateTime
  link            String?
  createdBy       User         @relation("EventCreator", fields: [createdByUserId], references: [id])
  createdByUserId String

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationCategory {
  grading
  deadlines
  course_updates
  team_admin
  community
}

model NotificationItem {
  id        String               @id @default(cuid())
  org       Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  category  NotificationCategory
  title     String
  targetUrl String?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([userId])
}

model NotificationPreference {
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  category NotificationCategory
  inApp    Boolean              @default(true)
  email    Boolean              @default(false)

  @@id([userId, category])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

enum AuditActionType {
  role_changed
  user_deactivated
  user_reactivated
  course_archived
  course_published
  certificate_revoked
  certificate_deleted
  org_settings_changed
  plan_changed
}

model AuditLogEntry {
  id            String          @id @default(cuid())
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String
  at            DateTime        @default(now())
  actor         User            @relation("AuditActor", fields: [actorUserId], references: [id])
  actorUserId   String
  action        AuditActionType
  summary       String
  targetLabel   String?
  /// Free-form key-value detail rendered in the detail drawer.
  detail        Json?

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id          String       @id @default(cuid())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  amountCents Int
  issuedAt    DateTime     @default(now())
  status      String // "paid" | "open"

  @@index([orgId])
}

model SeatRequest {
  id               String       @id @default(cuid())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String
  requestedBy      User         @relation(fields: [requestedByUserId], references: [id])
  requestedByUserId String
  additionalSeats  Int
  requestedAt      DateTime     @default(now())

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model Integration {
  id          String       @id @default(cuid())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  kind        String
  connected   Boolean      @default(false)
  connectedAt DateTime?
  config      Json         @default("{}")

  @@unique([orgId, kind])
}

model Webhook {
  id        String            @id @default(cuid())
  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  url       String
  events    String[]
  secret    String
  createdAt DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId  String
  event      String
  at         DateTime @default(now())
  statusCode Int

  @@index([webhookId])
}

model ApiKeyRecord {
  id         String    @id @default(cuid())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId      String
  name       String
  /// Only the masked form + a hash of the real key are ever stored — the real
  /// value is returned once, at creation, and never persisted in plaintext.
  maskedKey  String
  keyHash    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// SCORM / xAPI
// ---------------------------------------------------------------------------

model XapiStatement {
  id          String       @id @default(cuid())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  actorUserId String
  verb        String
  object      String
  at          DateTime     @default(now())

  @@index([orgId])
}

model LrsConnection {
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String       @id
  endpointUrl String
  authKey     String
  connected   Boolean      @default(false)
}

// ---------------------------------------------------------------------------
// Communities
// ---------------------------------------------------------------------------

enum ThreadScope {
  course
  org
}

model Thread {
  id              String       @id @default(cuid())
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId           String
  scope           ThreadScope
  course          Course?      @relation(fields: [courseId], references: [id])
  courseId        String?
  title           String
  createdBy       User         @relation("ThreadAuthor", fields: [createdByUserId], references: [id])
  createdByUserId String
  createdAt       DateTime     @default(now())
  pinned          Boolean      @default(false)
  locked          Boolean      @default(false)

  posts Post[]

  @@index([orgId])
  @@index([courseId])
}

model Post {
  id             String   @id @default(cuid())
  thread         Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId       String
  author         User     @relation(fields: [authorUserId], references: [id])
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  reports ContentReport[]

  @@index([threadId])
}

enum ReportReason {
  spam
  harassment
  off_topic
  other
}

model ContentReport {
  id               String       @id @default(cuid())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId            String
  post             Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId           String
  reportedBy       User         @relation("Reporter", fields: [reportedByUserId], references: [id])
  reportedByUserId String
  reason           ReportReason
  createdAt        DateTime     @default(now())
  resolved         Boolean      @default(false)

  @@index([orgId])
  @@index([postId])
}
