# Copy to .env and fill in — see docs/BACKEND_PLAN.md and the credentials
# checklist for where each of these comes from.

# Neon's *pooled* connection string, not the direct one — see BACKEND_PLAN.md's
# connection-pooling note for why this matters before it becomes an incident.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"

# Cloudflare R2 (Content Library / SCORM uploads) — used for the upload
# side (browser PUTs directly to R2 with these) and as a fallback download
# path before the CDN Worker below is deployed.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Cloudflare Worker CDN in front of R2 (see LMS/storage-worker/) — once both
# of these are set, every playback/download URL this app hands out switches
# from a direct R2 presigned URL to going through the Worker (Cloudflare's
# edge network end to end, never through this app server). CONTENT_WORKER_URL
# is the Worker's deployed URL (its workers.dev URL, or your custom domain
# once attached); CONTENT_SIGNING_SECRET must be the exact same value set via
# `wrangler secret put SIGNING_SECRET` in storage-worker/.
CONTENT_WORKER_URL=""
CONTENT_SIGNING_SECRET=""

# Transactional email (welcome/temp-password emails on account creation,
# course-access-granted emails) — see `src/email/resend.ts`. Both must be
# set for either to send; silently no-ops (falls back to relaying the temp
# password / access grant manually) if either is missing. EMAIL_FROM must be
# an address on a domain verified in your Resend account — Resend rejects
# sends from an unverified domain, and its shared onboarding@resend.dev
# sender only delivers to your own account email, not real recipients.
RESEND_API_KEY=""
# Either a bare address or "Display Name <address@domain>" — the latter is
# what recipients see as the sender, e.g. Yughma LMS <noreply@yughma.com>.
EMAIL_FROM=""

# Base URL used to build the login link in emails above. Defaults to
# CORS_ORIGIN, then http://localhost:3000, if unset.
APP_URL=""
